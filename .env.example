VIRUSTOTAL_API_KEY=
CERTSPOTTER_API_KEY=
HACKERTARGET_API_KEY=
# Opcional: sin clave NVD permite 5 consultas cada 30 s; con clave, 50
NVD_API_KEY=
# Modo Activo (httpx, tlsx, gowitness): siempre exige marcar «Tengo autorización» en
# cada escaneo. Opcional: limitarlo a estos dominios (separados por comas).
# Vacío = cualquier dominio, solo propios o con autorización por escrito.
RECONMAP_ACTIVE_ALLOWLIST=
# Servidores DNS separados por comas (vacío = los del sistema), p. ej. 9.9.9.9,1.1.1.1
RECONMAP_DNS_SERVERS=
